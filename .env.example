# ------------------------------------------------------------------
# The Pop Stop - backend environment variables
# Copy this file to `.env` and replace every placeholder. NEVER commit `.env`.
# ------------------------------------------------------------------

# ----- Server -----
PORT=4001
NODE_ENV=development
# Browser origin(s) allowed to call the API (comma separated)
FRONTEND_URL=http://localhost:5173
# Timezone used by the sales charts (monthly / daily grouping)
TIMEZONE=Asia/Manila

# ----- MongoDB Atlas -----
# Atlas > Connect > Drivers. Replace <username>, <password>, <cluster-host> and keep the database name (popstop)
DB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>.mongodb.net/popstop?retryWrites=true&w=majority

# ----- Session (JWT cookie) -----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_TIME=7d
# cookie lifetime in days
COOKIE_EXPIRES_TIME=7
# lax works for localhost; use "none" only when frontend and backend are on different domains over https
COOKIE_SAMESITE=lax

# ----- Cloudinary -----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ----- Email (Brevo) -----
# 1. Sign up at https://app.brevo.com
# 2. Settings > Senders > add and verify BREVO_FROM_EMAIL
# 3. SMTP & API > API Keys > generate a key with Transactional email = All
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_FROM_NAME=The Pop Stop
BREVO_FROM_EMAIL=thepopstopppp@gmail.com
# Public address of this API. The receipt button in order emails links here.
# BACKEND_URL=http://localhost:4001

# ----- Firebase Admin (verifies the ID tokens sent by the frontend) -----
# Option A (recommended): path to the service account JSON downloaded from Firebase console (relative to backend/)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Option B: leave the path empty and fill these three instead (keep the \n escapes inside the quotes)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
